# Always resolve this project's dependencies from the public npm registry.
#
# Without this, a global ~/.npmrc pointing at a private registry (corporate
# Artifactory, Nexus, Verdaccio...) leaks into package-lock.json: every
# "resolved" URL is rewritten to that host. CI then fails with
#   npm error code E401 / Incorrect or missing password
# because Vercel and GitHub Actions have no credentials for it.
#
# All dependencies here are public, so pinning the registry is safe and keeps
# the lockfile portable across machines and CI.
registry=https://registry.npmjs.org/
